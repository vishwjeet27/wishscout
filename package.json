{
  "name": "wishscout",
  "productName": "WishScout",
  "version": "1.0.0",
  "description": "Offline-first local business discovery, enrichment and outreach pipeline suite",
  "author": "Vishwjeet Singh Vilkhu",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.mjs",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.wishscout.app",
    "productName": "WishScout",
    "copyright": "Copyright (C) 2026 Vishwjeet Singh Vilkhu",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "NOTICE",
      "DISCLAIMER.md",
      "LICENSE"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "npmRebuild": false
  },
  "allowScripts": {
    "electron": true
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@electron/asar": "^4.3.1",
    "global-agent": "^4.1.3",
    "rimraf": "^6.1.3",
    "encoding-sniffer": "^1.0.2"
  }
}
